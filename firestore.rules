rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Each signed-in user can only read and write their own subtree.
    // Everything else is denied (there is no other match block).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Optional: also lock it to your Google account. Replace the line above with:
      // allow read, write: if request.auth != null && request.auth.uid == uid
      //                    && request.auth.token.email == "you@gmail.com"
      //                    && request.auth.token.email_verified == true;
    }
  }
}
